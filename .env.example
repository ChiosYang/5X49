# 5X49 published-image deployment configuration
# Copy this file to .env and adjust the host media path when needed.

# Host directory mounted into the backend container as /media.
# Examples: ./media, /volume1/video/movies, D:/Movies
MEDIA_DIR=./media

# Optional integrations. Local scanning and browsing work without either key.
TMDB_API_KEY=
OPENROUTER_API_KEY=

# Compatibility read source: canonical (default), shadow, or legacy
LIBRARY_READ_SOURCE=canonical

# The frontend connects to http://backend:8000 inside the Compose network.
